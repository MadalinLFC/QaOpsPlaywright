{
	"servers": {
		"playwright-automation-helper": {
			"type": "stdio",
			"command": "npm",
			"args": [
				"run",
				"mcp:server"
			]
		},
		"playwright": {
			"type": "stdio",
			"sandboxEnabled": false,
			"command": "npx",
			"cwd": "${workspaceFolder}",
			"args": [
				"-y",
				"@playwright/mcp@0.0.77"
			],
			"env": {}
		}
	},
	"inputs": []
}